---
import { Image } from "astro:assets";
import FutureLink from "./FutureLink.astro";
import logo from "../assets/img/logo.png";
import { clinic, futureNote, nav } from "../data/clinic";
---
<footer class="site-footer" data-rec="R-UX-11,S-R015,MA-R006">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="site-header__logo" href="#top" aria-label="Dental Space, на початок сторінки">
        <Image src={logo} alt="Dental Space — клініка естетичної стоматології" width={164} height={40} class="logo-img" />
      </a>
      <p class="muted">{clinic.slogan}</p>
    </div>
    <nav class="site-footer__nav" aria-label="Розділи сторінки, футер">
      <ul>{nav.map((n) => <li><a class="link" href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
    <div class="site-footer__contacts">
      <a class="site-footer__phone" href={clinic.phone.href}>{clinic.phone.display}</a>
      <a class="link" href={`mailto:${clinic.email}`}>{clinic.email}</a>
      <p>{clinic.address}, {clinic.city}</p>
      {clinic.hours.map((h) => <p>{h.days} {h.time}</p>)}
    </div>
    <div class="site-footer__social">
      <a class="link" href={clinic.instagram.href} target="_blank" rel="noopener">Instagram {clinic.instagram.handle}<span class="visually-hidden"> (відкриється в новій вкладці)</span></a>
      <a class="link" href={clinic.map} target="_blank" rel="noopener">Маршрут на Google Maps<span class="visually-hidden"> (відкриється в новій вкладці)</span></a>
    </div>
  </div>
  <div class="container site-footer__base">
    <p>© 2026 Dental Space</p>
    <FutureLink note={futureNote}>Політика конфіденційності</FutureLink>
  </div>
</footer>
