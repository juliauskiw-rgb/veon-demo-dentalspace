---
import { Picture } from "astro:assets";
import FutureLink from "./FutureLink.astro";
import ReceptionCard from "./ReceptionCard.astro";
import { doctors, founder, futureNote } from "../data/clinic";
import koval from "../assets/img/doctor-koval.jpg";
import ivakhniuk from "../assets/img/doctor-ivakhniuk.jpg";
import myronyk from "../assets/img/doctor-myronyk.jpg";
import khariv from "../assets/img/doctor-khariv.jpg";
import voloshchak from "../assets/img/doctor-voloshchak.jpg";
import chopyk from "../assets/img/doctor-chopyk.jpg";
const photos = { ivakhniuk, myronyk, khariv, voloshchak, chopyk } as const;
---
<section id="doctors" class="section doctors dark" data-rec="R-UX-5" aria-labelledby="doctors-title">
  <div class="container">
    <div class="doctors__head">
      <h2 id="doctors-title" data-reveal>Хто вас лікуватиме</h2>
      <FutureLink note={futureNote}>Усі лікарі</FutureLink>
    </div>
    <div class="doctors__grid">
      <article class="founder">
        <Picture src={koval} formats={["webp"]} widths={[400, 600, 900, 1200]} sizes="(min-width: 60rem) 34vw, 100vw" alt={`${founder.name}, засновник і головний лікар Dental Space`} loading="lazy" class="founder__img" />
        <div class="founder__text">
          <h3 class="founder__name">{founder.name}</h3>
          <p class="founder__role">{founder.role}</p>
          <p class="founder__spec">{founder.spec}</p>
        </div>
      </article>
      <ul class="team" role="list">
        {doctors.map((d) => (
          <li class="doc">
            <Picture src={photos[d.key]} formats={["webp"]} widths={[300, 480, 720]} sizes="(min-width: 60rem) 18vw, 45vw" alt={`${d.name}, ${d.spec.toLowerCase()}`} loading="lazy" class="doc__img" />
            <h3 class="doc__name">{d.name}</h3>
            <p class="doc__spec">{d.spec}</p>
          </li>
        ))}
        <li class="doc doc--card"><ReceptionCard variant="mini" /></li>
      </ul>
    </div>
  </div>
</section>
