---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import ReceptionCard from "./ReceptionCard.astro";
import { clinic } from "../data/clinic";
import sign from "../assets/img/contacts-sign.jpg";
---
<section id="contacts" class="section contacts" data-rec="R-UX-10,R-SP-8" aria-labelledby="contacts-title">
  <div class="container">
    <h2 id="contacts-title" class="contacts__title" data-reveal>Хіміків, 3б — як нас знайти</h2>
    <div class="contacts__grid">
      <ReceptionCard variant="contacts" class="contacts__card">
        <ul class="contacts__more" role="list">
          <li><a class="link with-icon" href={`mailto:${clinic.email}`}><Icon name="mail" size={18} />{clinic.email}</a></li>
          <li><a class="link with-icon" href={clinic.instagram.href} target="_blank" rel="noopener"><Icon name="instagram" size={18} />Instagram {clinic.instagram.handle}<span class="visually-hidden"> (відкриється в новій вкладці)</span></a></li>
        </ul>
      </ReceptionCard>
      <figure class="contacts__photo">
        <Picture src={sign} formats={["webp"]} widths={[400, 700, 1080]} sizes="(min-width: 60rem) 45vw, 100vw" alt="Стіна з вивіскою «Dental Space, клініка естетичної стоматології» на рецепції" loading="lazy" />
        <figcaption>Впізнаєте нас по цій стіні на рецепції.</figcaption>
      </figure>
    </div>
  </div>
</section>
