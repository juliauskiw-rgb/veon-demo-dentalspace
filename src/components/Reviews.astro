---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { clinic } from "../data/clinic";
import kryva from "../assets/img/review-kryva.png";
import shvets from "../assets/img/review-shvets.png";
import minkevych from "../assets/img/review-minkevych.png";
import shcherbyna from "../assets/img/review-shcherbyna.png";
import perets from "../assets/img/review-perets.png";
// Original Google review screenshots published by the clinic (C-020); alt = the review text as written.
const reviews = [
  { src: kryva, alt: "Відгук Anastasiia Kryva у Google, 5 зірок: «Неймовірна клініка з чудовою командою. Пролікувала усі свої зуби і залишилась дуже задоволена. Лікареві Ковалю О. В. велика вдячність за компетентність, відкритість та якість лікування!»" },
  { src: minkevych, alt: "Відгук Olha Minkevych у Google, 5 зірок: «Клініка Dental Space змінила моє ставлення до стоматології, нарешті мій похід до стоматолога став приємним та безболісним…»" },
  { src: perets, alt: "Відгук Makcim Perets у Google, 5 зірок: «Ходили з мамою в вашу клініку, добре та привітне обслуговування, вартість повністю відповідає якості, рекомендую»" },
  { src: shvets, alt: "Відгук Діани Швець у Google, 5 зірок: «Клініка, в якій працюють справжні професіонали. Неймовірна команда…»" },
  { src: shcherbyna, alt: "Відгук Anna Shcherbyna у Google, 5 зірок: «Дуже вдячна клініці Dental space за лікування! Якість та сервіс на високому рівні…»" },
];
---
<section id="reviews" class="section reviews" data-rec="R-UX-6" aria-labelledby="reviews-title">
  <div class="container reviews__grid">
    <div class="reviews__aside">
      <h2 id="reviews-title" class="reviews__title" data-reveal>
        <span class="figure figure--l">{clinic.rating.value}</span>
        <span class="h2-line">у Google — {clinic.rating.count} відгуків</span>
      </h2>
      <p class="reviews__source">Джерело: картка клініки, {clinic.rating.source}</p>
      <div class="reviews__links">
        <a class="link" href={clinic.map} target="_blank" rel="noopener">Відгуки на Google Maps<span class="visually-hidden"> (відкриється в новій вкладці)</span></a>
        <a class="link with-icon" href={clinic.instagram.href} target="_blank" rel="noopener"><Icon name="instagram" size={18} />Більше в Instagram {clinic.instagram.handle}<span class="visually-hidden"> (відкриється в новій вкладці)</span></a>
      </div>
    </div>
    <ul class="reviews__list" role="list" aria-label="Відгуки пацієнтів з Google">
      {reviews.map((r) => (
        <li class="review"><Image src={r.src} alt={r.alt} widths={[360, 540]} sizes="(min-width: 60rem) 26rem, 80vw" format="webp" loading="lazy" /></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .reviews__title .figure { overflow-wrap: break-word; min-width: 0; }
</style>
